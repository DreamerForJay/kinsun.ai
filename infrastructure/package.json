{
  "name": "@elderly-care/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "synth": "cdk synth",
    "synth:application": "cdk synth --app \"npx tsx bin/canonical-staging-application.ts\"",
    "diff": "cdk diff",
    "deploy": "cdk deploy KinsunCanonicalStagingFoundation",
    "deploy:application": "cdk deploy --app \"npx tsx bin/canonical-staging-application.ts\" KinsunCanonicalStagingApplication",
    "synth:legacy:audit": "cdk synth --app \"npx tsx bin/app.ts\""
  },
  "dependencies": {
    "aws-cdk-lib": "2.262.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1133.0",
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "esbuild": "^0.23.1",
    "@types/node": "^20.14.15"
  }
}
