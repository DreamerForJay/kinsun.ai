# 本機開發用設定範本。複製成 .env 後再改，.env 不進版控。
# 依 12 文件：Local 使用 .env.example，真實 Secret 走 AWS Secrets Manager／Parameter Store。

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=kinsun
POSTGRES_USER=kinsun
POSTGRES_PASSWORD=kinsun_local_dev
# 本機 5432 已被佔用時改這個值，例如 15432
POSTGRES_PORT=5432

# --- Application ---
# 一律使用 asyncpg 形式。Core API 直接用它；Alembic 會自行換成 psycopg，
# 因為 migration 走同步連線、應用層走非同步。
DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun
TEST_DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun_test

APP_ENV=development
# 本機開發用的假認證。APP_ENV=production 時無效，且沒有設定真的
# authenticator 就會 fail closed（所有請求 401）。
FAKE_AUTH_ENABLED=true
# 只可使用 Synthetic seed 身分。三個值由 Core server 端解析，瀏覽器不能覆寫。
FAKE_AUTH_ACTOR_ID=20000000-0000-4000-8000-000000000001
FAKE_AUTH_TENANT_ID=10000000-0000-4000-8000-000000000001
FAKE_AUTH_ACTOR_ROLE=ELDER

# --- Cognito + Google OAuth (staging placeholders; never commit real values) ---
# Core verifies Cognito JWTs only when explicitly enabled. The app client ID is
# the public PKCE web-client identifier used by the server-side BFF flow.
COGNITO_AUTH_ENABLED=false
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=replace-with-cognito-user-pool-id
COGNITO_APP_CLIENT_ID=replace-with-cognito-web-client-id
COGNITO_JWKS_CACHE_SECONDS=300
COGNITO_HTTP_TIMEOUT_SECONDS=5
# Generate a separate random value of at least 32 bytes per environment. It is
# blank here so a copied example fails closed until a real secret is injected.
FAMILY_INVITATION_HMAC_SECRET=

# Next.js BFF Hosted UI settings. Keep all of these server-only (no NEXT_PUBLIC
# prefix). Google client secrets remain in AWS Secrets Manager, not this file.
CORE_API_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
COGNITO_OAUTH_DOMAIN=https://replace-with-domain.auth.us-west-2.amazoncognito.com
COGNITO_WEB_CLIENT_ID=replace-with-cognito-web-client-id
COGNITO_CALLBACK_URL=http://localhost:3000/backend/auth/callback
COGNITO_LOGOUT_URL=http://localhost:3000/sign-in
# Keep blank in the example; inject a distinct 32+ character secret at runtime.
COGNITO_OAUTH_TRANSACTION_SECRET=
CORE_ONBOARDING_REDEEM_URL=http://127.0.0.1:8000/api/v1/onboarding/resolve

# CDK staging federation inputs. GOOGLE_OAUTH_CLIENT_SECRET_ID is a Secrets
# Manager name or ARN, never the secret value itself. The plural URL settings
# accept comma-separated exact URLs. Infrastructure rejects these outside staging.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET_ID=replace-with-secrets-manager-name-or-arn
COGNITO_DOMAIN_PREFIX=replace-with-globally-unique-staging-prefix
COGNITO_CALLBACK_URLS=http://localhost:3000/backend/auth/callback
COGNITO_LOGOUT_URLS=http://localhost:3000/sign-in

# Core 以 server-to-server 方式呼叫 Agent Runtime；瀏覽器不直接連線。
AGENT_RUNTIME_URL=http://127.0.0.1:8001
AGENT_RUNTIME_TIMEOUT_SECONDS=10
AGENT_RUNTIME_MODEL_ID=mock

# --- Agent Runtime (services/agent-runtime) ---
# mock = 本地規則式回覆，不呼叫任何外部 LLM。接上 Bedrock 前唯一可用的值。
MODEL_PROVIDER=mock
DEFAULT_LANGUAGE=zh-TW
LOG_LEVEL=INFO
# Agent 同步流程上限（AGENTS.md §7）。目前只有 MAX_AGENT_DECISIONS 真的被程式使用，
# 其餘三個已宣告但尚無 Tool 執行引擎，不代表已在管控。
MAX_AGENT_DECISIONS=3
MAX_TOOL_ROUNDS=2
MAX_TOTAL_TOOLS=5
MAX_REWRITE=1

# --- Adminer (選用，docker compose --profile tools up -d) ---
ADMINER_PORT=8080
