# 本機開發用設定範本。複製成 .env 後再改，.env 不進版控。
# 依 12 文件：Local 使用 .env.example，真實 Secret 走 AWS Secrets Manager／Parameter Store。

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=kinsun
POSTGRES_USER=kinsun
POSTGRES_PASSWORD=kinsun_local_dev
POSTGRES_RUNTIME_PASSWORD=kinsun_runtime_local_development_only_2026
# 本機 5432 已被佔用時改這個值，例如 15432
POSTGRES_PORT=5432

# --- Application ---
# 一律使用 asyncpg 形式。Core API 直接用它；Alembic 會自行換成 psycopg，
# 因為 migration 走同步連線、應用層走非同步。
DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun
TEST_DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun_test
# Local default uses QueuePool. ECS staging should override this to null for
# Aurora auto-pause and must not rely on DB_POOL_SIZE/DB_MAX_OVERFLOW in that mode.
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_RECOVERY_TIMEOUT_SECONDS=10

APP_ENV=development
# One-shot staging consent-policy bootstrap only. The command rejects
# APP_ENV=development/production and does not treat this as human approval.
CONSENT_POLICY_VERSION=demo-consent-v1
# 本機開發用的假認證。APP_ENV=production 時無效，且沒有設定真的
# authenticator 就會 fail closed（所有請求 401）。
FAKE_AUTH_ENABLED=true
# 只可使用 Synthetic seed 身分。三個值由 Core server 端解析，瀏覽器不能覆寫。
FAKE_AUTH_ACTOR_ID=20000000-0000-4000-8000-000000000001
FAKE_AUTH_TENANT_ID=10000000-0000-4000-8000-000000000001
FAKE_AUTH_ACTOR_ROLE=ELDER

# --- Cognito + Google OAuth (staging placeholders; never commit real values) ---
# Core verifies Cognito JWTs only when explicitly enabled. The app client ID is
# the public PKCE web-client identifier used by the server-side BFF flow.
COGNITO_AUTH_ENABLED=false
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=replace-with-cognito-user-pool-id
COGNITO_APP_CLIENT_ID=replace-with-cognito-web-client-id
COGNITO_JWKS_CACHE_SECONDS=300
COGNITO_HTTP_TIMEOUT_SECONDS=5
# Generate a separate random value of at least 32 bytes per environment. It is
# blank here so a copied example fails closed until a real secret is injected.
FAMILY_INVITATION_HMAC_SECRET=

# --- LINE Messaging API + official Account Linking ---
# Never commit real Channel secrets, access tokens, LINE user IDs, link tokens,
# nonces, or reply tokens. Keep linking disabled until all fixed staging values
# and the dedicated HMAC secret have been injected.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ACCOUNT_LINK_ENABLED=false
# Use a dedicated random 32+ byte secret that is never reused for the LINE
# Channel or family invitations. MVP key version and secret are immutable after
# the first ACTIVE link; rotation requires an explicit rekey/unlink migration.
LINE_IDENTITY_HMAC_SECRET=
LINE_IDENTITY_HMAC_KEY_VERSION=1
LINE_ACCOUNT_LINK_BASE_URL=https://replace-with-fixed-staging-origin.example.com
LINE_LINK_CHALLENGE_TTL_SECONDS=600
LINE_LINK_CHALLENGE_MAX_ATTEMPTS=3
LINE_MESSAGING_TIMEOUT_SECONDS=10
# Scheduled push needs the reversible destination only while calling LINE.
# Persist only authenticated ciphertext, encrypted with this independent 32+
# byte secret. Keep disabled until family linking and the 08:00 scheduler are
# intentionally enabled in the target environment.
LINE_SUBJECT_ENCRYPTION_SECRET=
LINE_DAILY_NOTIFICATION_ENABLED=false
LINE_DAILY_NOTIFICATION_TIMEZONE=Asia/Taipei
LINE_DAILY_NOTIFICATION_SEND_TIME=08:00

# Next.js BFF Hosted UI settings. Keep all of these server-only (no NEXT_PUBLIC
# prefix). Google client secrets remain in AWS Secrets Manager, not this file.
CORE_API_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
COGNITO_OAUTH_DOMAIN=https://replace-with-domain.auth.us-west-2.amazoncognito.com
COGNITO_WEB_CLIENT_ID=replace-with-cognito-web-client-id
COGNITO_CALLBACK_URL=http://localhost:3000/backend/auth/callback
COGNITO_LOGOUT_URL=http://localhost:3000/sign-in
# Keep blank in the example; inject a distinct 32+ character secret at runtime.
COGNITO_OAUTH_TRANSACTION_SECRET=
CORE_ONBOARDING_REDEEM_URL=http://127.0.0.1:8000/api/v1/onboarding/resolve

# --- LINE Login federation + explicit Cognito identity linking ---
# This is distinct from LINE Messaging API / official Account Linking above.
# Keep disabled until the LINE Login channel, Cognito OIDC provider, IAM grant,
# both callbacks, and Email permission have all been configured in staging.
LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
# Secret value is runtime-only. Never reuse LINE_CHANNEL_SECRET or any HMAC/
# OAuth transaction secret, and never commit or paste the real value.
LINE_LOGIN_CHANNEL_SECRET=
COGNITO_LINE_PROVIDER_NAME=LINE
LINE_LOGIN_LINK_CALLBACK_URL=http://localhost:3000/backend/auth/identities/line/callback
# Dedicated random value of at least 32 bytes; do not reuse another secret.
LINE_LOGIN_LINK_TRANSACTION_SECRET=

# CDK staging federation inputs. GOOGLE_OAUTH_CLIENT_SECRET_ID and
# LINE_LOGIN_CHANNEL_SECRET_ID are Secrets Manager names or ARNs, never secret
# values. The plural URL settings accept comma-separated exact URLs.
# Infrastructure rejects these outside staging.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET_ID=replace-with-secrets-manager-name-or-arn
COGNITO_DOMAIN_PREFIX=replace-with-globally-unique-staging-prefix
COGNITO_CALLBACK_URLS=http://localhost:3000/backend/auth/callback
COGNITO_LOGOUT_URLS=http://localhost:3000/sign-in
LINE_LOGIN_CHANNEL_SECRET_ID=replace-with-secrets-manager-name-or-arn
# Existing same-account IAM role used by the deployed Next.js BFF. CDK attaches
# only cognito-idp:AdminLinkProviderForUser for the target User Pool ARN.
LINE_LOGIN_BFF_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-staging-web-bff-role
LINE_LOGIN_PROVIDER_NAME=LINE

# Gate 1 Voice Ticket 預設關閉；啟用時必須由 Secret Manager／安全的本機環境注入
# 各環境獨立的 32+ byte secret。Ticket 最長 120 秒，且不得進 URL 或 log。
VOICE_TICKET_ENABLED=false
VOICE_TICKET_HMAC_SECRET=
VOICE_TICKET_TTL_SECONDS=60

# Core 以 server-to-server 方式呼叫 Agent Runtime；瀏覽器不直接連線。
AGENT_RUNTIME_URL=http://127.0.0.1:8001
AGENT_RUNTIME_TIMEOUT_SECONDS=10
AGENT_RUNTIME_MODEL_ID=mock

# --- Agent Runtime (services/agent-runtime) ---
# mock = 本地規則式回覆，不呼叫任何外部 LLM。接上 Bedrock 前唯一可用的值。
MODEL_PROVIDER=mock
DEFAULT_LANGUAGE=zh-TW
LOG_LEVEL=INFO
# Agent 同步流程上限（AGENTS.md §7）。目前只有 MAX_AGENT_DECISIONS 真的被程式使用，
# 其餘三個已宣告但尚無 Tool 執行引擎，不代表已在管控。
MAX_AGENT_DECISIONS=3
MAX_TOOL_ROUNDS=2
MAX_TOTAL_TOOLS=5
MAX_REWRITE=1
# Release version persisted on Core-owned AgentRun rows for Tool-capable turns.
AGENT_VERSION=0.0.1
# Tool-capable turns require a reachable Core API. Keep unset when only running
# local no-Tool conversations. The Runtime never stores a service token here;
# it forwards the caller's existing Authorization value for Core verification.
# CORE_API_BASE_URL=http://localhost:8001
CORE_API_TIMEOUT_SECONDS=5

# --- Staging RAG ---
# AWS credentials are intentionally not stored here. Local AWS authentication
# must come from the standard AWS credential provider chain.
AWS_REGION=
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBEDDING_DIMENSION=1024
OPENSEARCH_HOST=
OPENSEARCH_INDEX=ltc-public-knowledge-staging-v1
OPENSEARCH_ALIAS=ltc-public-knowledge-staging
RAG_ALLOWLIST_PATH=data/rag-manifest/AI_Reviewed_Embedding_Staging_Allowlist_v002.json
# Must come from an independently trusted deployment/configuration record before
# any Bedrock/OpenSearch operation; never derive it from the loaded Allowlist.
RAG_ALLOWLIST_EXPECTED_SHA256=
# Staging may use the narrowly scoped unsigned development override. Production
# always requires a signed/effective Allowlist regardless of this value.
RAG_REQUIRE_OWNER_SIGNATURE=false
# Hard kill switch for this staging-only release. Keep false; setting it true
# cannot enable a production target in the current ingestion service.
RAG_PRODUCTION_ENABLED=false
RAG_CHUNKS_DIR=data/rag-chunks/approved
RAG_MODE=staging
RAG_EMBEDDING_CONFIG_PATH=config/rag/embedding.yaml
RAG_OPENSEARCH_INDEX_CONFIG_PATH=config/rag/opensearch-index-v1.json
RAG_HYBRID_NATURAL_CONFIG_PATH=config/rag/hybrid-natural-language.json
RAG_HYBRID_LEGAL_CONFIG_PATH=config/rag/hybrid-legal.json
RAG_STAGING_FILTERS_CONFIG_PATH=config/rag/staging-filters.yaml
RAG_SMOKE_CONFIG_PATH=config/rag/smoke-test.yaml
# Server-to-server base URL used by the legacy TypeScript edge route and the
# ingestion E2E smoke test. The Python runtime owns retrieval and OpenSearch.
AGENT_RUNTIME_BASE_URL=http://localhost:8000
# Optional. If omitted, embedding artifacts are written below the OS temp
# directory. The ingestion service rejects paths inside this repository.
RAG_EMBEDDINGS_PATH=
# Optional. If omitted, the vector-free ingestion receipt is also written
# below the OS temp directory.
RAG_RECEIPT_PATH=

# --- Adminer (選用，docker compose --profile tools up -d) ---
ADMINER_PORT=8080

# --- Speech gateway (services/speech-gateway) ---
# Amazon Transcribe / Polly boundary for the voice path. Credentials come from
# the standard AWS credential provider chain, never from this file.
#
# Mandarin and English are served by Transcribe and Polly directly. Hokkien
# (nan-TW) and Hakka (hak-TW) recognition requires a self-hosted SageMaker
# endpoint; when SAGEMAKER_ASR_ENDPOINT is unset those languages are refused with
# 501 rather than falling through to the Mandarin model, which would return a
# fluent transcript of words the elder never said.
SAGEMAKER_ASR_ENDPOINT=
# No Hokkien/Hakka synthesis endpoint exists yet, so replies in those languages
# are returned as text. Leave blank until one is deployed.
SAGEMAKER_TTS_ENDPOINT=
# Below this score the caller must ask the elder to confirm or repeat instead of
# acting on the transcript. Kept equal to the ASR threshold used by the
# TypeScript implementation (packages/backend/src/asr/confidence.ts).
ASR_CONFIDENCE_THRESHOLD=0.6

# Browser-visible speech gateway URL. Public by necessity: the recorder posts
# audio from the page. The gateway stores nothing and makes no care decisions —
# consent and session state remain with Core.
NEXT_PUBLIC_SPEECH_GATEWAY_URL=http://127.0.0.1:8002

# Must equal the ACTIVE CONSENT version in eldercare_ai.policy_registry, created
# by app/consent_policy_bootstrap.py. A mismatch makes the consent panel refuse
# to grant rather than record consent against a policy version that does not exist.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=
