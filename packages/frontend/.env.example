# Next.js server-side proxy target. The browser only calls /backend/core/*.
CORE_API_INTERNAL_URL=http://127.0.0.1:8000

# Required in production for fail-closed Origin/CSRF validation. Keep this
# aligned with the exact public frontend origin (scheme + host + optional port).
FRONTEND_ORIGIN=http://localhost:3000

# Google is federated through the Cognito Hosted UI. These are server-only
# settings; do not prefix them with NEXT_PUBLIC and never commit real secrets.
COGNITO_OAUTH_DOMAIN=https://your-domain.auth.us-west-2.amazoncognito.com
COGNITO_WEB_CLIENT_ID=replace-with-cognito-web-client-id
COGNITO_CALLBACK_URL=http://localhost:3000/backend/auth/callback
COGNITO_LOGOUT_URL=http://localhost:3000/sign-in
COGNITO_OAUTH_TRANSACTION_SECRET=

# The BFF sends the Cognito ID token only server-to-server to this endpoint.
CORE_ONBOARDING_REDEEM_URL=http://127.0.0.1:8000/api/v1/onboarding/resolve

# Synthetic local policy created by scripts/seed_demo.py.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=demo-consent-v1

# WebSocket/ASR/TTS transport is intentionally not configured in this milestone.
