# 本機開發用設定範本。複製成 .env.local 後再改，.env.local 不進版控。
#
# 這兩個值來自 `infrastructure` 部署後的 CDK Output（RestApiUrl / WebSocketUrl）：
#   cd infrastructure
#   npx cdk deploy --context envName=dev
# 部署完成後終端機會印出 Outputs，或事後查詢：
#   npx cdk deploy --context envName=dev --outputs-file cdk-outputs.json
#
# 貼上時不必刻意去掉結尾的斜線 —— apiFetch() 會自動處理，但還是建議貼原始值就好，
# 不用手動編輯，减少貼錯的機會。

# RestApiUrl（CfnOutput），例如 https://xxxxx.execute-api.us-east-1.amazonaws.com/dev/
NEXT_PUBLIC_API_BASE_URL=

# WebSocketUrl（CfnOutput），例如 wss://xxxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_WS_URL=
