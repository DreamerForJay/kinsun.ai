{"chunk_id":"mohw_high_burden_caregiver_referral_service_flow_20250930_008_v004","chunk_file_id":"mohw_high_burden_caregiver_referral_service_flow_20250930_chunkset_v004","chunk_index":8,"parent_chunk_id":null,"source_id":"mohw_high_burden_caregiver_referral_service_flow_20250930","section":"6個月複評與結案備註8","page_start":1,"page_end":1,"source_locator":"PDF實體頁1；6個月複評與結案備註8","text":"【流程圖正規化】個案服務6個月後，進行成效評估及照顧負荷量表複評。複評為低負荷者回到家照服務單位提供諮詢、轉介或其他支持性服務。被照顧者已使用長照資源且主要照顧者複評仍為中、高負荷者持續服務。流程節點為「結案（註8）」。備註8：結案：個案解除照顧任務或照顧負荷降為低負荷。","embedding_text":"長照高負荷家庭照顧者轉介及服務流程｜6個月複評與結案備註8｜【流程圖正規化】個案服務6個月後，進行成效評估及照顧負荷量表複評。複評為低負荷者回到家照服務單位提供諮詢、轉介或其他支持性服務。被照顧者已使用長照資源且主要照顧者複評仍為中、高負荷者持續服務。流程節點為「結案（註8）」。備註8：結案：個案解除照顧任務或照顧負荷降為低負荷。","metadata":{"source_file":"長照高負荷家庭照顧者轉介及服務流程_1140930四修.pdf","document_title":"長照高負荷家庭照顧者轉介及服務流程","source_type":"risk_rule","publish_agency":"mohw","authority_level":"official_government","primary_category":"transition_referral","persona_restriction":"professional_only","requires_human_review":true,"stop_normal_rag":false,"review_status":"needs_review","confidence_level":"high","current_status":"current","license_status":"open","official_source_url":"https://www.mohw.gov.tw/dl-78166-3cc0f176-f0d8-4f06-8046-b5809dd2823a.html","official_source_page_url":"https://1966.gov.tw/LTC/cp-6455-69938-207.html","license_source_url":"https://1966.gov.tw/LTC/cp-6476-70761-207.html","attribution_required":true,"source_version":"114年9月30日四修","source_version_date":"2025-09-30","revised_at":"2025-09-30","version_published_at":"2025-10-09","source_page_updated_at":"2025-10-28","published_at":null,"last_verified_at":"2026-07-29","version_check_status":"verified_official_source","language":"zh-TW","locale":"zh-TW","token_count":null,"parser_version":"pdfplumber_bbox_visual_review_v3","chunker_version":"flow_graph_semantic_chunker_v3","embedding_model_id":"cohere.embed-v4:0","embedding_model_version":"v4.0","vector_dimension":1024,"embedding_status":"not_started","embedding_type":"float","similari