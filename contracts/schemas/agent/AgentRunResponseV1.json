{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/agent/AgentRunResponseV1.json",
  "title": "AgentRunResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "agent_run_id",
    "selected_agent",
    "reply_text",
    "reply_language",
    "safety_result",
    "context_manifest_id",
    "step_count",
    "result_status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "agent_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "selected_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reply_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "reply_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2})?$",
      "maxLength": 10
    },
    "safety_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision",
        "risk_level",
        "reason_codes",
        "matched_terms",
        "safe_reply"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "decision": {
          "type": "string",
          "enum": ["ALLOW", "BLOCK", "SAFE_FALLBACK", "HUMAN_REVIEW"]
        },
        "risk_level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "safe_reply": {
          "type": ["string", "null"],
          "maxLength": 4000
        }
      }
    },
    "context_manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "step_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "result_status": {
      "type": "string",
      "enum": ["SUCCESS", "BLOCKED", "SAFE_FALLBACK", "FAILED"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "event_candidate_proposal": {
      "description": "Optional review-required proposal. Null or absent means no proposal; Core alone may turn a valid proposal into a domain Candidate after reauthorization and consent checks.",
      "oneOf": [
        {
          "$ref": "https://kinsun.ai/contracts/schemas/agent/EventCandidateProposalV1.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
