{
  "$id": "https://kinsun.ai/contracts/schemas/domain/AgentRunRegistrationV1.json",
  "title": "AgentRunRegistrationV1",
  "description": "Core-owned AgentRun identity and immutable registration scope returned to the calling system service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_run_id",
    "session_id",
    "elder_id",
    "agent_id",
    "agent_version",
    "result_status",
    "policy_version",
    "trace_id"
  ],
  "properties": {
    "agent_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "elder_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "result_status": {
      "type": "string",
      "const": "RUNNING"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
