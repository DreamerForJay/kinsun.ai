{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/VoiceTicketIssuedV1.json",
  "title": "VoiceTicketIssuedV1",
  "type": "object",
