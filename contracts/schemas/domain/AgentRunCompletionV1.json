{
  "$id": "https://kinsun.ai/contracts/schemas/domain/AgentRunCompletionV1.json",
  "title": "AgentRunCompletionV1",
  "description": "Canonical terminal AgentRun state returned after compare-and-set completion or an identical replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_run_id",
    "session_id",
    "elder_id",
    "agent_id",
    "agent_version",
    "result_status",
    "policy_version",
    "trace_id",
    "stop_reason",
    "completed_at"
  ],
  "properties": {
    "agent_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "elder_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "result_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "HUMAN_REVIEW",
        "NO_DATA",
        "SCHEMA_FAILED",
        "DEPENDENCY_FAILED",
        "TIME_BUDGET_EXCEEDED",
        "COST_BUDGET_EXCEEDED",
        "CANCELLED"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
