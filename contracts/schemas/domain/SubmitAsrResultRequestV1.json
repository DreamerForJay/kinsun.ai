{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/SubmitAsrResultRequestV1.json",
  "title": "SubmitAsrResultRequestV1",
  "description": "Private Core-only ASR evidence. transcript is never a domain event, log, metric, trace, or public response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "language_route", "asr_model_version", "confidence", "transcript"],
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "language_route": {"type": "string", "enum": ["ZH_TW", "NAN_TW", "HAK_TW", "EN_US", "MIXED", "UNKNOWN"]},
    "asr_model_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "transcript": {"type": "string", "minLength": 1, "maxLength": 4000}
  }
}
