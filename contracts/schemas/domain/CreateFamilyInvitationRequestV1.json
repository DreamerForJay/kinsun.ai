{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/CreateFamilyInvitationRequestV1.json",
  "title": "CreateFamilyInvitationRequestV1",
  "description": "Elder-selected family sharing scope. The optional email is retained only as a keyed digest by Core.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "invitee_email": {
      "anyOf": [
        { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        { "type": "null" }
      ],
      "default": null
    },
    "share_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["REPORT_DAILY", "REPORT_WEEKLY", "REPORT_MONTHLY", "REPORT_IMPORTANT_EVENT"]
      },
      "default": ["REPORT_DAILY", "REPORT_WEEKLY", "REPORT_MONTHLY"]
    },
    "expires_in_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168,
      "default": 24
    }
  }
}
